# Copy to .env.azure and fill in values before running setup.ps1
# Supabase: Dashboard → Project Settings → Database / API

# ── Azure naming (must be globally unique) ──────────────────
AZURE_RESOURCE_GROUP=queztlearn-rg
AZURE_LOCATION=francecentral
AZURE_WEBAPP_BACKEND=queztlearn-api
AZURE_WEBAPP_FRONTEND=queztlearn-web
ACR_NAME=queztlearnacr
CONTAINER_APP_NAME=queztlearn-ai
CONTAINERAPPS_ENV=queztlearn-env
APP_SERVICE_PLAN=queztlearn-plan

# ── GitHub repo for OIDC (owner/repo) ───────────────────────
GITHUB_REPO=your-github-username/queztlearn-lms-main

# ── Database (Supabase) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# ── JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Supabase Storage ────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-north-1

# ── AI service ─────────────────────────────────────────────
AI_SERVICE_INTERNAL_TOKEN=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── Email (optional for first deploy) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QuetzLearn <noreply@example.com>

# ── Super admin (optional) ──────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD_HASH=

# ── LiveKit (optional) ────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Payments (optional) ───────────────────────────────────
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
