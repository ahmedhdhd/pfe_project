# Server
PORT=8000
AI_SERVICE_INTERNAL_TOKEN=change-me-to-a-long-random-secret

# Same Postgres as Express — pooler for optional fallback; ai-service prefers DIRECT_URL
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (Supabase Dashboard → Database → Direct connection). Used by ai-service.
DIRECT_URL=postgresql://user:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENROUTER_PLAYGROUND_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=QuetzLearn LMS
OPENROUTER_SUMMARY_MAX_TOKENS=1200
OPENROUTER_ASSIGNMENT_FEEDBACK_MAX_TOKENS=1400
OPENROUTER_ASSIGNMENT_GENERATION_MAX_TOKENS=2200

# Groq (video transcription)
GROQ_API_KEY=
