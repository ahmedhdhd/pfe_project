        <!-- Phase 3: Participation étudiant -->
        <mxCell id="phase3" parent="1" style="text;html=1;fontSize=12;fontStyle=3;fillColor=#f5f5f5;strokeColor=#666666;align=left;" value="Phase 3 — Participation de l'étudiant (US-047)" vertex="1">
          <mxGeometry height="20" width="1600" x="50" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="m28" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="28. Cliquer sur &quot;Rejoindre la session&quot;">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1480" as="sourcePoint" /><mxPoint x="295" y="1480" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m29" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="29. joinSession()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1520" as="sourcePoint" /><mxPoint x="475" y="1520" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m30" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="30. POST request">
          <mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1560" as="sourcePoint" /><mxPoint x="655" y="1560" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m31" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="31. POST /api/schedules/:id/join">
          <mxGeometry relative="1" as="geometry"><mxPoint x="665" y="1600" as="sourcePoint" /><mxPoint x="875" y="1600" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m32" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="32. authenticate()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1640" as="sourcePoint" /><mxPoint x="1055" y="1640" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m33" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="33. next()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="1680" as="sourcePoint" /><mxPoint x="885" y="1680" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m34" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="34. Générer JWT LiveKit (participant: canPublish=false)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1720" as="sourcePoint" /><mxPoint x="885" y="1760" as="targetPoint" /><Array as="points"><mxPoint x="935" y="1720" /><mxPoint x="935" y="1760" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="m35" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="35. Token participant">
          <mxGeometry relative="1" as="geometry"><mxPoint x="875" y="1800" as="sourcePoint" /><mxPoint x="665" y="1800" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m36" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="36. Token participant">
          <mxGeometry relative="1" as="geometry"><mxPoint x="655" y="1840" as="sourcePoint" /><mxPoint x="485" y="1840" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m37" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="37. connect(token)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1880" as="sourcePoint" /><mxPoint x="305" y="1880" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m38" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="38. Se connecter à la room (participant)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1920" as="sourcePoint" /><mxPoint x="1415" y="1920" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m39" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="39. Connexion WebRTC établie">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1415" y="1960" as="sourcePoint" /><mxPoint x="305" y="1960" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="loop" parent="1" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=2;perimeterSpacing=9;" value="[loop] Communication en temps réel + collecte de la transcription" vertex="1">
          <mxGeometry height="150" width="1660" x="40" y="2020" as="geometry" />
        </mxCell>


        <!-- Phase 4: Fin de session -->
        <mxCell id="phase4" parent="1" style="text;html=1;fontSize=12;fontStyle=3;fillColor=#f5f5f5;strokeColor=#666666;align=left;" value="Phase 4 — Fin de session et résumé automatique IA (US-048)" vertex="1">
          <mxGeometry height="20" width="1600" x="50" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="m40" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="40. Cliquer sur &quot;Terminer la session&quot;">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="2260" as="sourcePoint" /><mxPoint x="295" y="2260" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m41" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="41. endSession(transcriptDraft)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="2300" as="sourcePoint" /><mxPoint x="475" y="2300" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m42" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="42. POST request">
          <mxGeometry relative="1" as="geometry"><mxPoint x="485" y="2340" as="sourcePoint" /><mxPoint x="655" y="2340" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m43" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="43. POST /api/schedules/:id/end">
          <mxGeometry relative="1" as="geometry"><mxPoint x="665" y="2380" as="sourcePoint" /><mxPoint x="875" y="2380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m44" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="44. authenticate()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="2420" as="sourcePoint" /><mxPoint x="1055" y="2420" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m45" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="45. next()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="2460" as="sourcePoint" /><mxPoint x="885" y="2460" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m46" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="46. update status → COMPLETED, stocker transcript">
          <mxGeometry relative="1" as="geometry"><mxPoint x="885" y="2540" as="sourcePoint" /><mxPoint x="1235" y="2540" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m47" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="47. OK">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1235" y="2580" as="sourcePoint" /><mxPoint x="885" y="2580" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ALT 1 -->
        <mxCell id="alt1" parent="1" style="swimlane;startSize=35;fillColor=#fff2cc;strokeColor=none;fontSize=14;fontStyle=1;perimeterSpacing=9;" value="[alt] transcriptDraft disponible ?" vertex="1">
          <mxGeometry height="680" width="1660" x="40" y="2620" as="geometry" />
        </mxCell>

        <!-- Fail: Vide -->
        <mxCell id="alt1_fail1" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontSize=11;" value="[if] Transcript insuffisant ou vide → 200 OK (Pas de résumé)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="45" as="sourcePoint" /><mxPoint x="625" y="45" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_fail2" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontSize=11;" value="onSuccess">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="85" as="sourcePoint" /><mxPoint x="445" y="85" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_fail3" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="Session terminée">
          <mxGeometry relative="1" as="geometry"><mxPoint x="435" y="125" as="sourcePoint" /><mxPoint x="265" y="125" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_fail4" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="Afficher &quot;Session terminée (aucun résumé)&quot;">
          <mxGeometry relative="1" as="geometry"><mxPoint x="255" y="165" as="sourcePoint" /><mxPoint x="60" y="165" as="targetPoint" /></mxGeometry>
        </mxCell>


        <!-- Separator -->
        <mxCell id="alt1_sep" parent="alt1" style="line;strokeWidth=2;dashed=1;dashPattern=1 2;html=1;" vertex="1">
          <mxGeometry height="10" width="1660" x="0" y="190" as="geometry" />
        </mxCell>
        <mxCell id="alt1_sep_txt" parent="alt1" style="text;html=1;fontSize=12;fontStyle=1;" value="[else] Transcript disponible" vertex="1">
          <mxGeometry height="20" width="250" x="5" y="200" as="geometry" />
        </mxCell>

        <mxCell id="alt1_succ1" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="update summaryStatus → PENDING">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="240" as="sourcePoint" /><mxPoint x="1195" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ2" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="OK">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="280" as="sourcePoint" /><mxPoint x="835" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ3" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="POST /internal/v1/schedules/summarize">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="320" as="sourcePoint" /><mxPoint x="1555" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ4" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="Construire prompt de résumé">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1565" y="360" as="sourcePoint" /><mxPoint x="1565" y="400" as="targetPoint" /><Array as="points"><mxPoint x="1615" y="360" /><mxPoint x="1615" y="400" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ5" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="Résumé structuré">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1555" y="440" as="sourcePoint" /><mxPoint x="835" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ6" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="Stocker aiSummary, summaryStatus → READY">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="480" as="sourcePoint" /><mxPoint x="1195" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ7" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="OK">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="520" as="sourcePoint" /><mxPoint x="835" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="alt1_succ8" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="200 OK">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="560" as="sourcePoint" /><mxPoint x="625" y="560" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ9" edge="1" parent="alt1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="onSuccess">
          <mxGeometry relative="1" as="geometry"><mxPoint x="615" y="600" as="sourcePoint" /><mxPoint x="445" y="600" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ10" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="update summary">
          <mxGeometry relative="1" as="geometry"><mxPoint x="435" y="640" as="sourcePoint" /><mxPoint x="265" y="640" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="alt1_succ11" edge="1" parent="alt1" style="html=1;endArrow=block;endFill=1;fontSize=11;" value="Afficher le résumé IA de la session">
          <mxGeometry relative="1" as="geometry"><mxPoint x="255" y="670" as="sourcePoint" /><mxPoint x="60" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
