              <mxPoint x="540" y="405"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6: Générer une session courte (Jeton d&#39;accès)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
