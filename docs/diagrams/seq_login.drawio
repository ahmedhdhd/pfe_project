        <mxCell id="alt1" value="[alt] Email ou mot de passe invalide / compte non vérifié" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=2;" vertex="1" parent="1">
