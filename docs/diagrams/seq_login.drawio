        </mxCell>

        <!-- NOTE -->
        <mxCell id="note1" value="Note: Pour le Super Admin, les identifiants sont lus depuis les variables d&#39;environnement (SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD_HASH). Aucun enregistrement en DB n&#39;est nécessaire. Le refreshToken n&#39;est pas stocké en base pour le Super Admin." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;" vertex="1" parent="1">
