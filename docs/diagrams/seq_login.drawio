              <mxPoint x="400" y="670"/>
              <mxPoint x="310" y="670"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="m14" value="14: Rediriger vers le workspace selon le rôle (ADMIN → /admin, TEACHER → /admin, STUDENT → /)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="700" as="sourcePoint"/><mxPoint x="100" y="700" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m15" value="15: Afficher le tableau de bord (Dashboard)" style="html=1;endArrow=none;dashed=0;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1">
