        </mxCell>

        <mxCell id="m3" value="3: Vérifier l&#39;existence et le rôle de l&#39;utilisateur" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="235" as="sourcePoint"/><mxPoint x="970" y="235" as="targetPoint"/></mxGeometry>
