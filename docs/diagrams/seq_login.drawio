        <mxCell id="m7" value="7: Retourne le jeton d&#39;accès" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="465" as="sourcePoint"/><mxPoint x="540" y="465" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8: Générer une session prolongée (Jeton de rafraîchissement)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
