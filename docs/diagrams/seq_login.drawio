        </mxCell>

        <mxCell id="m9" value="9: Retourne le jeton de rafraîchissement" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="525" as="sourcePoint"/><mxPoint x="540" y="525" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10: Enregistrer la session prolongée en base" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="555" as="sourcePoint"/><mxPoint x="970" y="555" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m11" value="11: Session prolongée sauvegardée" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="970" y="585" as="sourcePoint"/><mxPoint x="540" y="585" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="m12" value="12: Réponse : Connexion réussie (avec jetons et infos utilisateur)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="620" as="sourcePoint"/><mxPoint x="310" y="620" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 13. Self-loop: store tokens -->
        <mxCell id="m13" value="13: Sauvegarder la session localement" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="650" as="sourcePoint"/>
