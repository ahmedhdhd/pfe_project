        </mxCell>
        <mxCell id="alt1msg" value="→ Réponse 401: « Invalid credentials » ou « Please verify your email first »" style="text;html=1;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="alt1">
          <mxGeometry x="5" y="30" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- 5. Self-loop: password check -->
        <mxCell id="m5" value="5: Vérifier la validité du mot de passe (crypté)" style="html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
