        <!-- PHASE 1: Indexation du contenu (pré-requis) -->
        <mxCell id="phase1" parent="1" style="text;html=1;fontSize=11;fontStyle=3;fillColor=#f5f5f5;strokeColor=#666666;align=left;" value="Phase 1 — Indexation du contenu (pré-requis, déclenché lors de la publication)" vertex="1">
