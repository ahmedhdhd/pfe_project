            <mxPoint x="500" y="895" as="sourcePoint" />
            <mxPoint x="750" y="895" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m21" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" value="21: Retourne les détails du jeton">
          <mxGeometry relative="1" as="geometry">
