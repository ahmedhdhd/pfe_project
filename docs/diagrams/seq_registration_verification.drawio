        <mxCell id="m23" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=10;" value="23: Activer le compte utilisateur (vérifié)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="1050" as="sourcePoint" />
            <mxPoint x="750" y="1050" as="targetPoint" />
