        <mxCell id="m26" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" value="26: Afficher « E-mail vérifié ! » + Rediriger vers la page de connexion">
          <mxGeometry relative="1" as="geometry">
