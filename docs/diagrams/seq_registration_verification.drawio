            <mxPoint x="500" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=10;" value="13: Demander l&#39;envoi de l&#39;e-mail de vérification">
