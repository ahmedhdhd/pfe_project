        <mxCell id="m14" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;fontSize=10;" value="14: E-mail livré: &#39;Vérifiez votre compte&#39; + lien {frontendUrl}/{slug}/verify?token={token}  [expire 24h]">
