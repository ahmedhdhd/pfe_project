            <mxPoint x="750" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" edge="1" parent="1" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;" value="10: Jeton enregistré (expire dans 24h)">
