        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n\n    participant ResetPasswordPage\n    participant AuthHook\n    participant APIClient\n    participant AuthController\n    participant Bcrypt\n    participant EmailService\n    database DB\n    participant Mailbox\n\n    note over ResetPasswordPage,Mailbox: Phase 1 — Password Reset Request\n\n    User -&gt;&gt; ResetPasswordPage: 1. Enter email address\n\n    activate ResetPasswordPage\n\n    ResetPasswordPage -&gt;&gt; AuthHook: 2. forgotPassword(email)\n\n    activate AuthHook\n\n    AuthHook -&gt;&gt; APIClient: 3. POST request\n\n    activate APIClient\n\n    APIClient -&gt;&gt; AuthController: 4. POST /api/auth/forgot-password\n\n    activate AuthController\n\n    AuthController -&gt;&gt; DB: 5. Find user by email\n\n    activate DB\n    DB --&gt;&gt; AuthController: User / null\n    deactivate DB\n\n    alt User not found\n\n        AuthController --&gt;&gt; APIClient: 6. 200 OK\n\n        APIClient --&gt;&gt; AuthHook: onSuccess()\n\n        AuthHook --&gt;&gt; ResetPasswordPage: Show confirmation\n\n        ResetPasswordPage -&gt;&gt; User: Instructions sent\n\n    else User found\n\n        AuthController -&gt;&gt; AuthController: 6. Generate reset token\n\n        AuthController -&gt;&gt; DB: 7. Save reset token\n\n        activate DB\n        DB --&gt;&gt; AuthController: Token saved\n        deactivate DB\n\n        AuthController -&gt;&gt; EmailService: 8. Send reset email\n\n        activate EmailService\n\n        EmailService -&gt;&gt; Mailbox: 9. Deliver reset link\n\n        EmailService --&gt;&gt; AuthController: Email accepted\n\n        deactivate EmailService\n\n        AuthController --&gt;&gt; APIClient: 10. 200 OK\n\n        APIClient --&gt;&gt; AuthHook: onSuccess()\n\n        AuthHook --&gt;&gt; ResetPasswordPage: Show confirmation\n\n        ResetPasswordPage -&gt;&gt; User: Instructions sent\n\n    end\n\n    deactivate AuthController\n    deactivate APIClient\n    deactivate AuthHook\n\n    note over ResetPasswordPage,Mailbox: Phase 2 — Set New Password\n\n    User -&gt;&gt; Mailbox: 11. Open reset email\n\n    Mailbox -&gt;&gt; ResetPasswordPage: 12. Open reset link\n\n    User -&gt;&gt; ResetPasswordPage: 13. Enter new password\n\n    activate AuthHook\n\n    ResetPasswordPage -&gt;&gt; AuthHook: 14. resetPassword(token, password)\n\n    AuthHook -&gt;&gt; APIClient: 15. POST request\n\n    activate APIClient\n\n    APIClient -&gt;&gt; AuthController: 16. POST /api/auth/reset-password\n\n    activate AuthController\n\n    AuthController -&gt;&gt; DB: 17. Validate reset token\n\n    activate DB\n    DB --&gt;&gt; AuthController: Valid token / Invalid token\n    deactivate DB\n\n    alt Invalid or expired token\n\n        AuthController --&gt;&gt; APIClient: 18. 400 Invalid token\n\n        APIClient --&gt;&gt; AuthHook: onError()\n\n        AuthHook --&gt;&gt; ResetPasswordPage: Display error\n\n        ResetPasswordPage -&gt;&gt; User: Invalid or expired link\n\n    else Valid token\n\n        AuthController -&gt;&gt; Bcrypt: 18. Hash password\n\n        activate Bcrypt\n        Bcrypt --&gt;&gt; AuthController: passwordHash\n        deactivate Bcrypt\n\n        AuthController -&gt;&gt; DB: 19. Update user password\n\n        activate DB\n        DB --&gt;&gt; AuthController: Updated\n        deactivate DB\n\n        AuthController -&gt;&gt; DB: 20. Mark reset token as used\n\n        activate DB\n        DB --&gt;&gt; AuthController: Updated\n        deactivate DB\n\n        AuthController --&gt;&gt; APIClient: 21. 200 OK\n\n        APIClient --&gt;&gt; AuthHook: onSuccess()\n\n        AuthHook --&gt;&gt; ResetPasswordPage: Password reset successful\n\n        ResetPasswordPage -&gt;&gt; User: Redirect to login page\n\n    end\n\n    deactivate AuthController\n    deactivate APIClient\n    deactivate AuthHook\n    deactivate ResetPasswordPage&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="of-k4WRBVEC06EHBv22B-3">
