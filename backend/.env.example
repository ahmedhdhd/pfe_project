# Database
DATABASE_URL="postgresql://user:password@localhost:5432/queztlearn"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# AWS S3
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="queztlearn-media"
AWS_CLOUDFRONT_URL="https://d2qbkdyhv7dt4j.cloudfront.net"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="TeslaAcademy <noreply@yourdomain.com>"

# Flouci
FLOUCI_PUBLIC_KEY="your-flouci-public-key"
FLOUCI_PRIVATE_KEY="your-flouci-private-key"
# Optional legacy fallback names still supported by the codebase:
# RAZORPAY_KEY_ID="legacy-public-key"
# RAZORPAY_KEY_SECRET="legacy-private-key"

# OTP (optional — Twilio or Fast2SMS)
OTP_PROVIDER="fast2sms"
FAST2SMS_API_KEY="your-fast2sms-key"

# LiveKit
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# AI (OpenRouter only — chat + RAG embeddings + teacher playground)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324"
# Embeddings for pgvector (default 3072 dims — must match content_embeddings column)
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-large"
# Optional — OpenRouter ranking / attribution
# OPENROUTER_HTTP_REFERER="http://localhost:3000"
# OPENROUTER_APP_TITLE="My LMS"

# Paymee (optional, for payment gateway switching)
PAYMEE_API_BASE_URL="https://sandbox.paymee.tn"
PAYMEE_VENDOR="1234"

# Groq — speech-to-text for non-YouTube lecture videos (requires ffmpeg on the server PATH)
GROQ_API_KEY=""
