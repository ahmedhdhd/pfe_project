# Database
DATABASE_URL="postgresql://user:password@localhost:5432/queztlearn"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Supabase Storage (primary media + live session recordings)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="your-bucket-name"
# S3-compatible API keys — Supabase Dashboard → Project Settings → Storage → S3 Access Keys
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_S3_REGION="eu-north-1"
# Optional override (default: https://<project-ref>.storage.supabase.co/storage/v1/s3)
# SUPABASE_S3_ENDPOINT="https://your-project-ref.storage.supabase.co/storage/v1/s3"

# AWS S3 (optional fallback for LiveKit egress if Supabase S3 is not configured)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="queztlearn-media"
AWS_CLOUDFRONT_URL="https://d2qbkdyhv7dt4j.cloudfront.net"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="TeslaAcademy <noreply@yourdomain.com>"

# Flouci
FLOUCI_PUBLIC_KEY="your-flouci-public-key"
FLOUCI_PRIVATE_KEY="your-flouci-private-key"
# Optional legacy fallback names still supported by the codebase:
# RAZORPAY_KEY_ID="legacy-public-key"
# RAZORPAY_KEY_SECRET="legacy-private-key"

# OTP (optional — Twilio or Fast2SMS)
OTP_PROVIDER="fast2sms"
FAST2SMS_API_KEY="your-fast2sms-key"

# LiveKit
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
# Optional — HTTP base URL for egress Twirp API (defaults from LIVEKIT_URL). Required for AI session summaries.
# LIVEKIT_EGRESS_URL="https://your-project.livekit.cloud"
# Egress destination: Supabase S3 when SUPABASE_S3_* is set (default). Set to "aws" to force AWS S3 instead.
# LIVEKIT_EGRESS_STORAGE="supabase"
# Local egress only (self-hosted LiveKit + egress worker on same machine as API):
# LIVEKIT_EGRESS_OUTPUT_DIR="./storage/livekit-egress"
# LIVEKIT_EGRESS_MAX_WAIT_MS=1800000

# AI microservice (FastAPI) — LLM, RAG, embeddings, playgrounds, assignment AI
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_INTERNAL_TOKEN="change-me-to-a-long-random-secret"

# Paymee (optional, for payment gateway switching)
PAYMEE_API_BASE_URL="https://sandbox.paymee.tn"
PAYMEE_VENDOR="1234"

# All OpenRouter / Groq / ffmpeg: configure in ai-service/.env (see ai-service/.env.example)
