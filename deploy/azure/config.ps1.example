# Copy to config.ps1 and fill in your values before running setup.ps1 / deploy.ps1
$ErrorActionPreference = "Stop"

# Azure subscription (run: az account show)
$SubscriptionId = "YOUR_SUBSCRIPTION_ID"

# Resource naming (must be globally unique where noted)
$ResourceGroup   = "queztlearn-rg"
$Location        = "westeurope"          # or francecentral, northeurope, etc.
$AppServicePlan  = "queztlearn-plan"
$BackendAppName  = "queztlearn-api"      # -> https://queztlearn-api.azurewebsites.net
$FrontendAppName = "queztlearn-web"      # -> https://queztlearn-web.azurewebsites.net
$AcrName         = "queztlearnacr"       # alphanumeric only, globally unique
$ContainerEnv    = "queztlearn-env"
$AiAppName       = "queztlearn-ai"

# URLs (update after first deploy if names differ)
$BackendUrl  = "https://queztlearn-api.azurewebsites.net"
$FrontendUrl = "https://queztlearn-web.azurewebsites.net"

# Database — keep Supabase (recommended for student budget) or Azure Postgres
# Paste from Supabase: Project Settings -> Database -> Connection string (URI)
$DatabaseUrl = "postgresql://user:password@db.xxx.supabase.co:5432/postgres?sslmode=require"
$DirectUrl   = "postgresql://user:password@db.xxx.supabase.co:5432/postgres?sslmode=require"

# Secrets — generate long random strings
$JwtSecret        = "CHANGE_ME_min_32_chars_jwt_secret________"
$JwtRefreshSecret = "CHANGE_ME_min_32_chars_refresh_secret____"
$AiInternalToken  = "CHANGE_ME_long_random_internal_token____"

# Supabase storage (from backend/.env.example)
$SupabaseUrl              = "https://xxx.supabase.co"
$SupabaseServiceRoleKey   = "your-service-role-key"
$SupabaseBucket           = "your-bucket"
$SupabaseS3AccessKeyId    = ""
$SupabaseS3SecretAccessKey = ""
$SupabaseS3Region         = "eu-north-1"

# AI keys (ai-service)
$OpenRouterApiKey = ""
$GroqApiKey       = ""

# Email (optional for first deploy)
$SmtpHost = "smtp.gmail.com"
$SmtpPort = "587"
$SmtpUser = ""
$SmtpPass = ""
$SmtpFrom = "QuetzLearn <noreply@yourdomain.com>"
